# Bridgeway Digital CMS - local environment. Never commit credentials.
APP_NAME="Bridgeway Digital CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
ADMIN_APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000
# Public SEO origin is independent of local networking; authored SEO is preserved.
WEBSITE_URL=https://bridgewaydigital.com
PUBLIC_ASSET_URL=http://127.0.0.1:8000/storage
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Set your local PostgreSQL account credentials before installation.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bridgeway
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=disable
DB_PERSISTENT=false
DB_DIRECT_PORT=5432
DB_DIRECT_DATABASE=bridgeway

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_PREFIX=bridgewaydigital_local_cache
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
QUEUE_AFTER_COMMIT=true
SCHEDULED_QUEUE_WORKER_ENABLED=false

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_COOKIE=bridgewaydigital_cms_local_session

# Optional Redis/Horizon integrations are not required for local operation.
REDIS_CLIENT=predis
REDIS_PREFIX=bridgewaydigital_local_
HORIZON_NAME="Bridgeway Digital Local"
HORIZON_PREFIX=bridgewaydigital_local_horizon:

# All local notifications are written to logs, never the former SMTP server.
MAIL_MAILER=log
NOTIFICATION_MAILER=log
MAIL_FROM_ADDRESS=no-reply@bridgewaydigital.test
MAIL_FROM_NAME="Bridgeway Digital"
ADMIN_INQUIRY_RECIPIENTS=sales@bridgewaydigital.test
# For production SMTP, set NOTIFICATION_MAILER=notification-smtp and provide:
# NOTIFICATION_MAIL_HOST=smtp.example.com
# NOTIFICATION_MAIL_PORT=587
# NOTIFICATION_MAIL_ENCRYPTION=tls
# NOTIFICATION_MAIL_USERNAME=
# NOTIFICATION_MAIL_PASSWORD=
# Also replace MAIL_FROM_ADDRESS above with the verified production sender.
INQUIRY_NOTIFICATIONS_ENABLED=true
INQUIRY_NOTIFICATIONS_QUEUED=false
MAIL_OUTBOX_ENABLED=true
MAIL_OUTBOX_QUEUE_ENABLED=false
MAIL_OUTBOX_SCHEDULE_ENABLED=false
MAIL_OUTBOX_CACHE_STORE=file
MAIL_OUTBOX_BATCH_SIZE=25
MAIL_OUTBOX_MAX_ATTEMPTS=3
MAIL_OUTBOX_RETRY_SECONDS=300
MAIL_OUTBOX_LOCK_SECONDS=120

INQUIRY_RATE_LIMIT_PER_MINUTE=10
INQUIRY_SPAM_DETECTION_ENABLED=true
INQUIRY_HONEYPOT_FIELD=company
INQUIRY_MINIMUM_SECONDS=2
INQUIRY_MAX_LINKS=3
INQUIRY_SPAM_BLOCK_SCORE=5
INQUIRY_CAPTCHA_ENABLED=false

FRONTEND_API_CACHE_ENABLED=true
FRONTEND_API_CACHE_TTL=300
FRONTEND_API_CACHE_STORE=redis
FRONTEND_API_CACHE_PREFIX=bridgewaydigital_frontend
FRONTEND_API_DEFAULT_PER_PAGE=12
FRONTEND_API_MAX_PER_PAGE=100
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
FRONTEND_REVALIDATE_SECRET=
FRONTEND_REVALIDATE_TIMEOUT=3
FRONTEND_INTERNAL_IPS=127.0.0.1,::1

ADMIN_FILE_MANAGER_DISK=public
ADMIN_FILE_MANAGER_QUOTA_BYTES=5368709120
ADMIN_FILE_MANAGER_MAX_UPLOAD_KB=10240
ADMIN_FILE_MANAGER_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,svg,ico,pdf,doc,docx,xls,xlsx,csv,txt,zip,mp4,webm
ADMIN_FILE_MANAGER_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp,svg,ico

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:8000,127.0.0.1:8000

ADMIN_SEED_EMAIL=admin@bridgewaydigital.test
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME="Bridgeway Digital Administrator"
ADMIN_SEED_RESET_PASSWORD=false
SERVICE_FINDER_ENABLED=false
VITE_APP_NAME="${APP_NAME}"
